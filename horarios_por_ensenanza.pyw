# Patrón para detectar "MATERIA (PROFESOR)" dentro de un trozo de texto.
PATRON_MATERIA_PROFESOR = re.compile(
    r"([A-ZÁÉÍÓÚÜÑ][A-ZÁÉÍÓÚÜÑ0-9 \.\-]+?)\s*\(([^)]+)\)",
    re.IGNORECASE | re.UNICODE,
)

# Paleta de colores para diferenciar profesor+materia dentro de cada horario.
# Se van asignando por orden de aparición y se reciclan si hay más
# combinaciones que colores.
PALETA_COLORES = [
    RGBColor(0xEE, 0x00, 0x00),  # rojo
    RGBColor(0x00, 0xB0, 0x50),  # verde
    RGBColor(0x00, 0x70, 0xC0),  # azul
    RGBColor(0xE3, 0x6C, 0x0A),  # naranja
    RGBColor(0x70, 0x30, 0xA0),  # morado
    RGBColor(0xC0, 0x00, 0x40),  # granate
    RGBColor(0x00, 0x80, 0x80),  # teal
    RGBColor(0x80, 0x80, 0x00),  # oliva
    RGBColor(0xB8, 0x60, 0x00),  # marrón
    RGBColor(0x1F, 0x4E, 0x79),  # azul marino
    RGBColor(0xC0, 0x50, 0x4D),  # rojo teja
    RGBColor(0x54, 0x82, 0x35),  # verde oliva oscuro
]


def eliminar_tildes(cadena):
    if not cadena:
        return ""
    s = "".join(
        c for c in unicodedata.normalize("NFD", str(cadena))
        if unicodedata.category(c) != "Mn"
    )
    return s.upper().strip()


def aplicar_color_espad(run, texto):
    t = eliminar_tildes(texto)
    if "1.2" in t:
        run.font.color.rgb = RGBColor(255, 0, 0)
    elif "2.1" in t:
        run.font.color.rgb = RGBColor(0, 128, 0)
    elif "2.2" in t:
        run.font.color.rgb = RGBColor(0, 0, 255)
    else:
        run.font.color.rgb = RGBColor(128, 0, 128)


def color_para_clave(clave, color_map):
    """Devuelve (y memoriza) el color asignado a una clave materia|profesor,
    tomándolo de la paleta por orden de aparición dentro del documento."""
    if clave not in color_map:
        idx = len(color_map) % len(PALETA_COLORES)
        color_map[clave] = PALETA_COLORES[idx]
    return color_map[clave]


def aplicar_color_generico(run, texto, color_map):
    """Colorea un run según la pareja MATERIA (PROFESOR) que contenga,
    manteniendo el mismo color cada vez que se repite esa combinación
    dentro del mismo documento."""
    m = PATRON_MATERIA_PROFESOR.search(texto)
    if not m:
        return
    materia = m.group(1).strip().rstrip(".,- ")
    profesor = m.group(2).strip()
    if len(materia) < 2 or materia.isdigit():
        return
    clave = f"{eliminar_tildes(materia)}|{eliminar_tildes(profesor)}"
    run.font.color.rgb = color_para_clave(clave, color_map)


def extraer_ensenanzas_y_profesores(ruta_docx):
    doc = Document(ruta_docx)
    patron = PATRON_MATERIA_PROFESOR
    resultado = defaultdict(set)

    for tabla in doc.tables:
        for fila in tabla.rows:
            for c_idx, celda in enumerate(fila.cells):
                if c_idx == 0:
                    continue
                for linea in celda.text.splitlines():
                    linea = re.sub(r"\b\d{1,2}:\d{2}\b", "", linea)
                    linea = re.sub(r"\bhasta\b", "", linea, flags=re.IGNORECASE)
                    linea = linea.strip()
                    if not linea:
                        continue
                    for m in patron.finditer(linea):
                        mat = m.group(1).strip().rstrip(".,- ")
                        prf = m.group(2).strip()
                        if len(mat) < 2 or mat.isdigit():
                            continue
                        resultado[eliminar_tildes(mat)].add(eliminar_tildes(prf))

    return dict(resultado)



def _fijar_fuente_run(run, nombre_fuente="Arial"):
    """Fuerza la fuente de un run tanto en texto normal como en eastasia/cs,
    ya que Word puede llevar la fuente Cambria fijada a esos niveles."""
    run.font.name = nombre_fuente
    rPr = run._element.get_or_add_rPr()
    rFonts = rPr.find(qn("w:rFonts"))
    if rFonts is None:
        rFonts = OxmlElement("w:rFonts")
        rPr.append(rFonts)
    for attr in ("w:ascii", "w:hAnsi", "w:eastAsia", "w:cs"):
        rFonts.set(qn(attr), nombre_fuente)


def insertar_titulo(doc, texto, nombre_fuente="Arial"):
    """Inserta un párrafo con 'texto' en negrita justo antes de la primera
    tabla del documento, a modo de título del horario."""
    if not doc.tables:
        return
    primera_tabla = doc.tables[0]._tbl
    p = doc.add_paragraph()  # se añade al final; luego se reubica
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run = p.add_run(texto)
    run.bold = True
    run.font.size = Pt(16)
    _fijar_fuente_run(run, nombre_fuente)
    primera_tabla.addprevious(p._p)


def _limpiar_parrafo(p):
    """Elimina todos los runs de un párrafo, dejándolo vacío pero
    conservando el propio párrafo (y su alineación/estilo)."""
    for run in list(p.runs):
        run._element.getparent().remove(run._element)


def insertar_encabezado_pie(doc):
    """Sustituye el encabezado y el pie de página de cada sección del
    documento por las imágenes de membrete del centro (logo/edificio
    arriba, dirección/contacto abajo), ajustadas al ancho útil de la
    página y conservando su proporción original."""
    img_header = base64.b64decode(_ENCABEZADO_PNG_B64)
    img_footer = base64.b64decode(_PIE_PNG_B64)

    for seccion in doc.sections:
        seccion.header.is_linked_to_previous = False
        seccion.footer.is_linked_to_previous = False
        ancho_util = seccion.page_width - seccion.left_margin - seccion.right_margin

        # Encabezado: ocupa todo el ancho útil de la página
        p_header = seccion.header.paragraphs[0]
        _limpiar_parrafo(p_header)
        p_header.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_header.add_run().add_picture(BytesIO(img_header), width=ancho_util)

        # Pie de página: algo más estrecho y centrado, como en el original
        p_footer = seccion.footer.paragraphs[0]
        _limpiar_parrafo(p_footer)
        p_footer.alignment = WD_ALIGN_PARAGRAPH.CENTER
        ancho_pie = int(ancho_util * 0.55)
        p_footer.add_run().add_picture(BytesIO(img_footer), width=ancho_pie)


def aplicar_formato_fuente(doc, nombre_fuente="Arial"):
    """Pone toda la tabla en la fuente indicada y en negrita la fila de
    días de la semana (fila 0) y la columna de horas (columna 0)."""
    # Fuente por defecto del documento, por si hay texto sin 'run' explícito
    try:
        estilo_normal = doc.styles["Normal"]
        estilo_normal.font.name = nombre_fuente
        rPr = estilo_normal.element.get_or_add_rPr()
        rFonts = rPr.find(qn("w:rFonts"))
        if rFonts is None:
            rFonts = OxmlElement("w:rFonts")
            rPr.append(rFonts)
        rFonts.set(qn("w:eastAsia"), nombre_fuente)
    except Exception:
        pass

    for tabla in doc.tables:
        for f_idx, fila in enumerate(tabla.rows):
            for c_idx, celda in enumerate(fila.cells):
                es_dia_u_hora = (f_idx == 0) or (c_idx == 0)
                for p in celda.paragraphs:
                    for run in p.runs:
                        _fijar_fuente_run(run, nombre_fuente)
                        if es_dia_u_hora:
                            run.font.bold = True


def pdf_a_docx(ruta_pdf):
    """
    Convierte el PDF a un Document de python-docx en memoria,
    replicando la estructura de tabla para que el resto del script
    funcione igual que con un Word original.
    Devuelve la ruta de un docx temporal.
    """
    import tempfile, os
    from docx import Document as DocxDoc
    from docx.shared import Pt
    from docx.enum.text import WD_ALIGN_PARAGRAPH

    with pdfplumber.open(ruta_pdf) as pdf:
        page = pdf.pages[0]
        tables = page.extract_tables()
        if not tables:
            raise ValueError("No se encontró ninguna tabla en el PDF.")
        raw = tables[0]

    # Colapsar columnas duplicadas (pdfplumber suele partir cada columna real
    # del PDF en varias columnas "fantasma" por las líneas internas de la
    # celda fusionada). En vez de asumir un ancho fijo de 3 columnas por día
    # -algo que fallaba cuando dos días quedaban en columnas consecutivas,
    # p.ej. LUNES en la 3 y MARTES en la 4, perdiendo los datos de MARTES-
    # detectamos los límites reales a partir de dónde aparece cada
    # encabezado (LUNES, MARTES...) en la fila 0.
    n_cols = len(raw[0])
    cabecera = raw[0]
    inicios = sorted({i for i, v in enumerate(cabecera) if v and str(v).strip()})
    if not inicios or inicios[0] != 0:
        inicios = [0] + inicios
    limites = inicios + [n_cols]  # cada columna real = [limites[i], limites[i+1])

    collapsed = []
    for row in raw:
        new_row = []
        for i in range(len(limites) - 1):
            inicio, fin = limites[i], limites[i + 1]
            val = None
            for ci in range(inicio, fin):
                if ci < n_cols and row[ci]:
                    val = row[ci]
                    break
            new_row.append(val or "")
        collapsed.append(new_row)

    # Eliminar fila separadora vacía entre mañana y tarde
    collapsed = [r for r in collapsed if any(c.strip() for c in r)]

    doc = DocxDoc()
    n_filas = len(collapsed)
    n_cols2 = len(collapsed[0])
    tabla = doc.add_table(rows=n_filas, cols=n_cols2)
    tabla.style = "Table Grid"

    for r_idx, row in enumerate(collapsed):
        for c_idx, val in enumerate(row):
            cell = tabla.cell(r_idx, c_idx)

            # El PDF a veces corta una entrada "MATERIA (PROFESOR)" justo
            # entre la materia y el profesor por falta de ancho en la
            # celda (ej.: "16:30 TALLER INGLÉS" en una línea y "(JOAQUÍN)"
            # en la siguiente). Si se dejaran como párrafos separados, el
            # filtrado posterior (que exige materia y profesor en el
            # mismo párrafo) perdería la entrada entera. Aquí recomponemos
            # esas líneas cortadas antes de crear los párrafos.
            crudas = val.split("\n") if val else [""]
            partes = []
            i = 0
            while i < len(crudas):
                actual = crudas[i].strip()
                while i + 1 < len(crudas):
                    siguiente = crudas[i + 1].strip()
                    incompleta = (")" not in actual) and siguiente.startswith("(")
                    parentesis_sin_cerrar = actual.count("(") > actual.count(")")
                    if not (incompleta or parentesis_sin_cerrar):
                        break
                    i += 1
                    actual = (actual + " " + siguiente).strip()
                partes.append(actual)
                i += 1

            cell.paragraphs[0].text = partes[0]
            cell.paragraphs[0].alignment = WD_ALIGN_PARAGRAPH.CENTER
            for parte in partes[1:]:
                p = cell.add_paragraph(parte)
                p.alignment = WD_ALIGN_PARAGRAPH.CENTER

    tmp = tempfile.NamedTemporaryFile(suffix=".docx", delete=False)
    tmp.close()
    doc.save(tmp.name)
    return tmp.name


